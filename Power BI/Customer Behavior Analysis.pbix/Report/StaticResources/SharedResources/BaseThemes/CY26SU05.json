{
  "name": "Executive Dark Glassmorphic",
  "dataColors": [
    "#00F0FF",
    "#8A2BE2",
    "#00E676",
    "#FF2A6D",
    "#FFB703",
    "#3B82F6",
    "#EC4899",
    "#14B8A6",
    "#F97316",
    "#A855F7",
    "#6366F1"
  ],
  "background": "#0B0F19",
  "foreground": "#FFFFFF",
  "tableAccent": "#00F0FF",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#151D2A" } },
            "transparency": 20
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#2A364F" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI",
            "bold": true,
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#94A3B8" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "bold": true
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#94A3B8" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "bold": true
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "bold": true
          }
        ],
        "legend": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#CBD5E1" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0B0F19" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#05070E" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}